Algoritmo Operaciones
	Definir num1, num2, resultado, resultado2 Como Real 
	
	Escribir "Ingrese Número 1: "
	leer num1
	Escribir "Ingrese Número 2: "
	leer num2
	
	resultado <- num1 MOD num2
	Escribir "El resultado es: ", resultado
	
	resultado2 <- trunc(num1/num2)
	Escribir "El resultado es: ", resultado2
	
FinAlgoritmo
